# ARIA backend configuration. Copy to .env and fill in.
# Generate the two secrets below with:  python -m aria.hashpw

ARIA_PASSWORD_HASH=
ARIA_SESSION_SECRET=
ARIA_USERNAME=admin

# Node discovery — tried in order. First is mDNS, second a static fallback so
# demo day does not depend on mDNS alone. Point at 127.0.0.1 to use the simulator.
ARIA_NODE_HOSTS=aria.local,192.168.1.50
ARIA_NODE_PORT=80
ARIA_NODE_TIMEOUT_S=3.0

# Polling and storage
ARIA_POLL_INTERVAL_S=5.0
ARIA_DB_PATH=aria.db
ARIA_RETENTION_DAYS=14

# Serving
ARIA_HOST=0.0.0.0
ARIA_PORT=8000
ARIA_STATIC_DIR=../frontend/dist
